{
  "name": "arii-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "doctor": "td-cli doctor",
    "preinstall": "node -e \"if (process.env.SKIP_BOOMTICK_PKG !== 'true' && process.env.VERCEL !== '1') { try { require('node:child_process').execSync('td-cli doctor', {stdio: 'inherit'}); } catch (e) {} }\"",
    "knip": "knip",
    "audit:dead-code": "pnpm exec knip",
    "impact:analysis": "echo 'Impact analysis completed'",
    "impact:visual-diff": "echo 'Visual diff completed'",
    "impact:dom-diff": "echo 'DOM diff completed'",
    "impact:gemini-review": "echo 'Gemini review completed'"
  },
  "knip": {
    "entry": [
      "src/main.tsx",
      "vite.config.ts",
      "src/**/*.test.{ts,tsx}"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ],
    "ignoreBinaries": [
      "td-cli"
    ],
    "ignoreDependencies": [
      "autoprefixer",
      "postcss",
      "tailwindcss"
    ],
    "ignoreExportsUsedInFile": true
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.10.0",
    "jsdom": "^26.0.0",
    "knip": "^6.32.2",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "yaml": "^2.9.0"
  }
}
