{
  "name": "arii-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "impact:analysis": "tsx boomtick-pkg/scripts/impact-analysis.ts",
    "impact:build-main": "tsx boomtick-pkg/scripts/impact-build-main.ts",
    "impact:visual-diff": "tsx boomtick-pkg/scripts/impact-visual-diff.ts",
    "impact:dom-diff": "NODE_OPTIONS=--max-old-space-size=8192 tsx boomtick-pkg/scripts/impact-dom-diff.ts",
    "impact:gemini-review": "tsx boomtick-pkg/scripts/impact-ai-review.ts gemini",
    "impact:github-models-review": "tsx boomtick-pkg/scripts/impact-ai-review.ts github-models",
    "impact:gemini-code-review": "tsx boomtick-pkg/scripts/impact-ai-code-review.ts gemini",
    "impact:github-models-code-review": "tsx boomtick-pkg/scripts/impact-ai-code-review.ts github-models",
    "preinstall": "node -e \"if (process.env.SKIP_BOOMTICK_PKG !== 'true' && process.env.VERCEL !== '1') { try { require('node:child_process').execSync('td-cli doctor', {stdio: 'inherit'}); } catch (e) {} }\"",
    "postinstall": "python3 boomtick-pkg/scripts/sync-python-deps.py"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.2.8",
    "@langchain/google-genai": "^2.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.10.0",
    "jsdom": "^26.0.0",
    "openai": "^7.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
